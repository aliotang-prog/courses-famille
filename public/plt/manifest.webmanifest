{
  "name": "PLT Viewer – Visionneuse HPGL",
  "short_name": "PLT Viewer",
  "description": "Visionneuse de fichiers HPGL / HP-GL/2 (.plt, .hpgl) pour PC et Android, hors ligne.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "lang": "fr",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/vnd.hp-hpgl": [".plt", ".hpgl", ".hpg", ".hgl", ".plo", ".spl"] }
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["application/vnd.hp-hpgl", "application/octet-stream", "text/plain", ".plt", ".hpgl", ".hpg", ".hgl", ".plo", "*/*"] }
      ]
    }
  }
}
