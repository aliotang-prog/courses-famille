{
  "name": "courses-famille",
  "private": true,
  "version": "1.0.0",
  "description": "Liste de courses collaborative en Dirhams, temps réel — serveur maison (Express) ou en ligne (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx server.ts --prod",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.worker.json",
    "build:web": "vite build",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute courses-famille-db --remote --file=schema.sql"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "wrangler": "^4.40.0"
  }
}
